# ─────────────────────────────────────────────────────────────
# Пример переменных окружения (этап 1).
# НЕ коммитить реальный .env. В проде секреты — в host env-файле
# /etc/technic-portal/prod.env (root:root, 0600), вне docker-образа.
# ─────────────────────────────────────────────────────────────

# ── App ──
NODE_ENV=production
API_PORT=3000
API_HOST=0.0.0.0
# Публичный origin портала (для CSRF/Origin-проверки и secure cookie)
PUBLIC_ORIGIN=https://auto.su10.ru
LOG_LEVEL=info

# ── PostgreSQL (Yandex Managed) ──
# Runtime-пользователь без DDL-прав
DATABASE_URL=postgres://technic_runtime:CHANGE_ME@rc1a-xxxxxxxx.mdb.yandexcloud.net:6432/technic_portal?sslmode=verify-full
# Путь к Yandex root CA (монтируется read-only)
PGSSLROOTCERT=/etc/technic-portal/certs/yandex-root.crt
DB_POOL_MAX=10
# Migration-пользователь с DDL (используется ТОЛЬКО migrate-контейнером)
DATABASE_MIGRATION_URL=postgres://technic_migration:CHANGE_ME@rc1a-xxxxxxxx.mdb.yandexcloud.net:6432/technic_portal?sslmode=verify-full
# Maintenance-пользователь административного пути: смена режима модуля истории назначения
# (сервис `assignment-mode` профиля tools). Прикладной DATABASE_URL там не используется намеренно.
# Пока роль `technic_maintenance` не заведена, команда ходит DATABASE_MIGRATION_URL.
DATABASE_MAINTENANCE_URL=postgres://technic_maintenance:CHANGE_ME@rc1a-xxxxxxxx.mdb.yandexcloud.net:6432/technic_portal?sslmode=verify-full

# ── Auth ──
# Ed25519 ключи в PEM (SPKI/PKCS8). Приватный ключ — только у api-сервиса.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KID=technic-2026-01
JWT_ISSUER=technic-portal
JWT_AUDIENCE=technic-portal-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Секреты для подписи cookie и CSRF-токена (min 32 байта)
COOKIE_SECRET=CHANGE_ME_min_32_bytes_random
CSRF_SECRET=CHANGE_ME_min_32_bytes_random
# Argon2id (дефолты @node-rs/argon2 = OWASP-min)
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1

# ── cloud.ru Evolution Object Storage (S3) ──
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=technic-portal-files
# Access key format: <tenant_id>:<key_id>
S3_ACCESS_KEY_ID=TENANT_ID:KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME
# path-style (https://s3.cloud.ru/<bucket>/<key>) — ОБЯЗАТЕЛЬНО true для cloud.ru.
# Virtual-hosted-style (https://<bucket>.s3.cloud.ru/...) отдаёт 403 AccessDenied на всё,
# включая анонимный CORS-preflight, — см. docs/setup-infra.md §3.
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=600
S3_DOWNLOAD_URL_TTL_SECONDS=120

# ── Лимиты файлов ──
FILE_MAX_SIZE_BYTES=52428800
FILE_MAX_PER_REQUEST=20

# ── Срок хранения отклонённых заявок на регистрацию (ADR 0063) ──
# Через сколько дней воркер сносит из архива учётку, которой отказали в регистрации: неделя на
# исправление ошибочного отказа, дальше персональные данные не хранятся. Учёток с ролью уборка не
# касается. 0 и меньше — выключено.
USER_REJECTED_REGISTRATION_TTL_DAYS=7

# ── Почта (сейчас — корпоративный ящик Яндекс 360; план docs/mail-integration-plan.md) ──
# Расписания, роли и состав рассылок сюда НЕ выносятся: их задаёт администратор во вкладке
# «Рассылки». Здесь только эксплуатационные параметры.
#
# Домен отправителя должен быть подтверждён у провайдера, а в его зоне прописаны DKIM, SPF и DMARC
# (docs/setup-infra.md). Без этого письма уходят в спам или отбиваются.

# Включает почтовые сценарии портала и планировщик рассылок.
MAIL_ENABLED=false

# log — разработка без внешней доставки (письмо составляется и остаётся в журнале); smtp — боевая.
MAIL_TRANSPORT=log

# Яндекс 360: smtp.yandex.ru:465 с implicit TLS. У транзакционных сервисов бывает 587 + STARTTLS —
# тогда SMTP_SECURE=false.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
# Полный адрес ящика-отправителя.
SMTP_USER=
# Для Яндекса — ПАРОЛЬ ПРИЛОЖЕНИЯ из Яндекс ID, не пароль учётной записи. Секрет: в git не
# коммитится, задаётся только в prod.env на сервере.
SMTP_PASSWORD=

# Имя и адрес отправителя. У почтовых служб общего назначения (Яндекс, Mail.ru) адрес обязан
# совпадать с ящиком из SMTP_USER: чужой From они отвергают ответом 550.
MAIL_FROM="Портал Техник <no-reply@example.ru>"
# Куда попадут ответы людей на письма портала; пусто — на MAIL_FROM.
MAIL_REPLY_TO=

# Потолок отправки, писем в минуту: лимит провайдера с запасом. Рассылка на сотни адресов
# растягивается во времени, а не получает отказы пачкой. Для корпоративного ящика Яндекса — 20:
# суточный предел там 3000 писем, и превышать темп незачем.
MAIL_MAX_PER_MINUTE=20

# ── Дополнительные почтовые каналы ──
#
# Всё выше — основной канал (`default`): им уходят задания водителям, сводки и письма про доступ.
# Канал сверх него описывается своим набором переменных `MAIL_ACCOUNT_<КЛЮЧ>_*`; ключ известен
# порталу (реестр в `packages/contracts/src/mail-accounts.ts`), и письмо выбирает канал по нему.
#
# Заводить второй канал приходится не ради удобства: почтовые службы отвергают чужой `From`, а SPF
# и DKIM домена подписывает его собственный сервер. Письмо «от службы ремонта» через провайдерский
# транспорт просто не уйдёт.
#
# Канал считается объявленным, если задана хотя бы одна его переменная; настроенным наполовину —
# worker откажется стартовать, назвав недостающие. Незаданный канал не ошибка: письма этого канала
# ждут настройки, остальные идут своим ходом.
#
# MAIL_ACCOUNT_REPAIR_HOST=m.example.ru
# 465 — implicit TLS (SECURE=true), 587 — STARTTLS (SECURE=false). Пара «порт + защита» проверяется
# на старте: перепутанная не ломается сразу, а вешает соединение до таймаута — ночью, на первом
# письме.
# MAIL_ACCOUNT_REPAIR_PORT=465
# MAIL_ACCOUNT_REPAIR_SECURE=true
# Метод аутентификации: LOGIN (обычный пароль поверх TLS, умолчание), PLAIN или CRAM-MD5 — последнее
# почтовые клиенты называют «зашифрованным паролем».
# MAIL_ACCOUNT_REPAIR_AUTH_METHOD=CRAM-MD5
# MAIL_ACCOUNT_REPAIR_USER=repair@example.ru
# Секрет: в git не коммитится, задаётся только в prod.env на сервере.
# MAIL_ACCOUNT_REPAIR_PASSWORD=
# MAIL_ACCOUNT_REPAIR_FROM="Ремонт оргтехники <repair@example.ru>"
# Куда уйдёт ответ, если письмо своего обратного адреса не задало; пусто — на FROM канала.
# MAIL_ACCOUNT_REPAIR_REPLY_TO=
# Свой потолок: у корпоративного сервера пределы не те, что у транзакционного провайдера. Пусто —
# берётся MAIL_MAX_PER_MINUTE.
# MAIL_ACCOUNT_REPAIR_MAX_PER_MINUTE=20

# Часовой пояс времени рассылок и границ календарных периодов дайджеста (IANA).
MAIL_SCHEDULER_TIMEZONE=Europe/Moscow

# Срок ссылки подтверждения регистрации (24 ч) и ссылки сброса пароля (1 ч).
MAIL_VERIFY_TTL_SECONDS=86400
MAIL_RESET_TTL_SECONDS=3600

# Через сколько дней архивируется регистрация, так и не подтвердившая email. Ноль — уборка
# выключена; так и надо, пока подтверждение отключено (`EMAIL_VERIFICATION_ENABLED`, ADR 0072):
# новые заявки приходят подтверждёнными и под уборку не попадают, а поданные до отключения
# подтвердить уже нечем — и через неделю они уехали бы в архив ни за что.
MAIL_REGISTRATION_EXPIRY_DAYS=0

# Общий секрет worker → API для внутренних почтовых маршрутов (`/internal/mail/*`, ADR 0075):
# планировщик действует не от имени человека, поэтому не JWT. Нужен обоим сервисам; наружу
# `/internal/*` не проксируется. Секрет, в git не коммитится.
INTERNAL_API_TOKEN=

# Как worker достучится до API внутри сети compose. Менять нужно только при своих именах сервисов.
INTERNAL_API_URL=http://technic-api:3000

# Как часто worker спрашивает, чьё время рассылки наступило.
MAILING_TICK_INTERVAL_MS=60000

# ── Sentry (опц.) ──
SENTRY_DSN=

# ── Frontend (build-time) ──
VITE_API_BASE_URL=/api/v1
# Токен «Подсказок» DaData для автодополнения адресов (ADR 0006). Публичный, но
# ОБЯЗАТЕЛЬНО ограничьте его по домену в кабинете DaData. Пусто → поле работает как
# обычный ввод (адрес помечается «введён вручную»). Секретный ключ «Стандартизации»
# на этом этапе НЕ используется.
VITE_DADATA_SUGGEST_TOKEN=
