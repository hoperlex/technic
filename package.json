{
  "name": "technic-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Портал строительной компании — вывоз мусора (этап 1)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm dev:db && pnpm -r --parallel dev",
    "dev:db": "pnpm --filter @technic/api dev:db",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:release": "eslint . -c eslint/release.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "node scripts/check.mjs",
    "check:db": "node scripts/check-db.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test:docs": "node --test scripts/docs-navigation.test.mjs",
    "maintain": "node tools/maintenance/cli/main.ts",
    "maintain:typecheck": "tsc --noEmit -p tools/maintenance/tsconfig.json",
    "docs:index": "node scripts/gen-adr-index.mjs",
    "db:generate": "pnpm --filter @technic/api db:generate",
    "db:migrate": "pnpm --filter @technic/api db:migrate",
    "seed:admin": "pnpm --filter @technic/api seed:admin",
    "seed:drivers-test": "pnpm --filter @technic/api seed:drivers-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "yaml": "^2.8.0"
  }
}
