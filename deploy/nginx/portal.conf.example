# Пример / канон edge-vhost для infra-nginx (Docker), не host-nginx.
# На VPS живой файл: /opt/infra/nginx/conf.d/technic.conf
# Шаблон в репо: deploy/nginx/technic.conf (держит nip.io→auto.su10.ru redirect).
#
# Установка / обновление:
#   sudo cp deploy/nginx/technic.conf /opt/infra/nginx/conf.d/technic.conf
#   docker exec infra-nginx nginx -t && docker exec infra-nginx nginx -s reload
#
# Порты 80/443 слушает только контейнер infra-nginx (сеть edge).
# technic-web без host-ports; proxy_pass по Docker DNS на technic-web:80.
# Соседние vhost (zakupki, estimat, billhub, keycloak) не трогать.
#
# Упрощённый фрагмент (без legacy nip.io) — для справки:

server {
    listen 80;
    server_name auto.su10.ru;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://auto.su10.ru$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name auto.su10.ru;

    ssl_certificate     /etc/letsencrypt/live/auto.su10.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auto.su10.ru/privkey.pem;

    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    # Вложения показываются окном просмотра прямо в портале (картинка <img>, PDF/текст <iframe>),
    # а ссылка на объект ведёт на хранилище — поэтому s3.cloud.ru нужен в img-src и frame-src.
    # Без этого окно просмотра остаётся пустым: default-src 'self' режет и картинку, и фрейм.
    # blob: в frame-src — для печати путевого листа (ADR 0041): бланк приходит телом ответа и
    # показывается фреймом из памяти вкладки. Под 'self' такой адрес не подпадает — у blob:
    # собственный источник, и без явной схемы браузер режет фрейм, оставляя окно печати пустым.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://s3.cloud.ru https://*.s3.cloud.ru https://smartcaptcha.cloud.yandex.ru https://captcha-api.yandex.ru; frame-src 'self' blob: https://s3.cloud.ru https://*.s3.cloud.ru https://smartcaptcha.cloud.yandex.ru https://captcha-api.yandex.ru; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' https://smartcaptcha.cloud.yandex.ru https://captcha-api.yandex.ru; connect-src 'self' https://s3.cloud.ru https://*.s3.cloud.ru https://suggestions.dadata.ru https://smartcaptcha.cloud.yandex.ru https://captcha-api.yandex.ru" always;

    client_max_body_size 2m;

    resolver 127.0.0.11 valid=30s ipv6=off;
    set $web technic-web;

    location / {
        proxy_pass http://$web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Перезапись, а не дополнение: внешний nginx видит настоящего клиента, и присланный
        # клиентом X-Forwarded-For — вымысел. Дописывать к нему свой адрес значит его узаконить.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
