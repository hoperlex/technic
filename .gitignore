# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example
# Файл окружения стенда приёмки (deploy/docker-compose.stand.yml): в нём лежат ключи dev-капчи и
# секреты JWT/cookie. Под правила выше он не подпадает — имя не начинается с точки, — а репозиторий
# публичный, поэтому запрещаем явно.
deploy/stand.env

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

temp/

# Маркер задеплоенного коммита (пишется ручными деплоями на VPS). В git не нужен;
# также исключён из build-context в .dockerignore (иначе COPY . . бьёт кэш сборки).
.deployed-sha

# Сканы талонов для замера распознавания (ADR 0114). Репозиторий публичный, а на бланках ПДн:
# фамилии ответственных, госномера машин, подписи. Файлы нужны только на машине, где идёт замер, —
# в историю они не попадают ни при `git add -A`, ни по неосторожности.
docs/image/test-tikets/
docs/image/test-tickets/

# Отметка о зелёном прогоне ворот качества (ADR 0147): пишется `pnpm check` и `pnpm check:db`,
# читается deploy-auto на выкатах без отката. В git не нужна — файл говорит про конкретное рабочее
# дерево, а не про историю, и коммит отметки менял бы тот самый SHA, о котором она сообщает.
# Также исключена из build-context в .dockerignore (иначе COPY . . бьёт кэш сборки).
.quality-check
